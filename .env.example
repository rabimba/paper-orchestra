# --- Offloaded Inference on Puffingbird (Dual NVIDIA H100 NVL GPUs) ---
# When serving models via vLLM or Ollama on puffingbird, route calls via OPENAI_BASE_URL:
# OPENAI_BASE_URL=http://172.23.79.37:8000/v1
# OPENAI_API_KEY=local-h100

# --- Direct Cloud Frontier API Keys (Optional) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# --- Remote Puffingbird Execution Config ---
PUFFINGBIRD_HOST=172.23.79.37
PUFFINGBIRD_USER=rabimba
PUFFINGBIRD_PROJECT_DIR=/data/rabimba/projects/paper-orchestra
PUFFINGBIRD_ENV=/data/rabimba/envs/paper-orchestra
PUFFINGBIRD_STORAGE_ROOT=/data/rabimba
